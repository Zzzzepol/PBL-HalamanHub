# Laptop-only database for ESP32 sensor readings and local plant profiles.
# Keep MongoDB bound to 127.0.0.1.
IOT_MONGODB_URI=mongodb://127.0.0.1:27017/halamanhub_iot

# Cloud database for admin/customer accounts, settings, irrigation controls and
# history, products, orders, payments, and cloudplantprofiles.
# MONGODB_URI is supported as the existing cloud URI for older installs.
SHOP_MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>

# Required shared secret used by the Python USB gateway for device API requests.
# It stays on the laptop; do not put it in the ESP32 firmware.
IOT_DEVICE_TOKEN=PASTE_A_RANDOM_64_CHARACTER_HEX_TOKEN_HERE

# Required for signing admin/shop login sessions. Replace with a long random value.
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Used once by `npm run seed:admin` if no admin account already exists in Atlas.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD

# Optional: set these to enable Google sign-in for the customer shop.
GOOGLE_CLIENT_ID=REPLACE_WITH_YOUR_GOOGLE_OAUTH_CLIENT_ID

# Optional: required for PayMongo checkout and payment webhooks.
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=

PORT=4000
CLIENT_ORIGIN=http://localhost:3000
SHOP_ORIGIN=http://localhost:3001
