# Laptop-only database for ESP32 readings, irrigation settings, admin users,
# alerts, and activity history. Keep MongoDB bound to 127.0.0.1.
IOT_MONGODB_URI=mongodb://127.0.0.1:27017/halamanhub_iot

# Cloud database for products, customer accounts, orders, payments, and the
# separate cloudplantprofiles collection used for plant profile sync.
# MONGODB_URI is supported as the existing cloud URI for older installs.
SHOP_MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>

# Required shared secret for ESP32 POST readings and GET watering settings.
# Generate a random token and copy the same value into ESP32/halamanhub_config.h.
IOT_DEVICE_TOKEN=PASTE_A_RANDOM_64_CHARACTER_HEX_TOKEN_HERE

PORT=4000
CLIENT_ORIGIN=http://localhost:3000
SHOP_ORIGIN=http://localhost:3001
